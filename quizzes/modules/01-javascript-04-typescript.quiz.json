    {
      "id": "ts-iface-q1",
      "topic": "Interfaces",
      "question": "What is the key difference between an `interface` and a `type` alias in TypeScript?",
      "options": [
        {
          "id": "a",
          "text": "They are completely identical with no differences"
        },
        {
          "id": "b",
          "text": "Interfaces are extendable/merged via declaration merging; type aliases cannot be reopened"
        },
        {
          "id": "c",
          "text": "type aliases can only hold primitives"
        },
        {
          "id": "d",
          "text": "Interfaces compile to JavaScript; type aliases do not"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Interfaces support declaration merging and 'extends'; type aliases are closed and support unions/intersections better.",
      "difficulty": "medium",
      "tags": [
        "interface",
        "type"
      ]
    },
    {
      "id": "ts-iface-q2",
      "topic": "Interfaces",
      "question": "Which is a valid way to make a property optional in an interface?",
      "options": [
        {
          "id": "a",
          "text": "name?: string;"
        },
        {
          "id": "b",
          "text": "optional name: string;"
        },
        {
          "id": "c",
          "text": "name string?;"
        },
        {
          "id": "d",
          "text": "name!: string;"
        }
      ],
      "correctOptionId": "a",
      "explanation": "The ? postfix marks an optional property.",
      "difficulty": "easy",
      "tags": [
        "optional"
      ]
    },
    {
