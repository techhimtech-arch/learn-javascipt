          "text": "Only with 'class'"
        },
        {
          "id": "d",
          "text": "Only for arrow functions"
        }
      ],
      "correctOptionId": "b",
      "explanation": "Interfaces can declare call signatures, index signatures, and construct signatures.",
      "difficulty": "medium",
      "tags": [
        "call-signature"
